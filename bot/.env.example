# MetaTrader5 Connection - Exness Configuration
MT5_LOGIN=your_exness_login
MT5_PASSWORD=your_exness_password
# Exness servers: ExnessMarketsPro-Demo (demo), ExnessMarketsPro-Real (live)
MT5_SERVER=ExnessMarketsPro-Demo
# MT5_PATH=/path/to/terminal64.exe  # Optional, full path to MT5 terminal

# Trading Configuration - Exness Optimized
# Single pair (backwards compatible):
TRADING_SYMBOL=EURUSD

# Multi-pair support (comma-separated, takes precedence over TRADING_SYMBOL):
# Recommended Exness pairs with tight spreads:
# TRADING_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,NZDUSD

# Strategy Parameters - Exness optimized (faster response for 1-min timeframe)
FAST_MA_PERIOD=12
SLOW_MA_PERIOD=26
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Risk Management - Conservative settings for demo trading
STOP_LOSS_PIPS=30
TAKE_PROFIT_PIPS=60
MAX_DAILY_LOSS_PERCENT=3.0
MAX_POSITION_SIZE=0.5
MAX_TRADES_PER_DAY=10
TRADE_TIMEOUT_MINUTES=60

# Trading Hours (UTC)
TRADING_START_HOUR=0
TRADING_END_HOUR=23

# Execution
CHECK_INTERVAL_SECONDS=60

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
MAX_LOG_SIZE_MB=10
BACKUP_COUNT=5

# Database
DB_PATH=./trading_bot.db

# TEST MODE - For testing trade execution without waiting for real signals
# Options: "off" (normal operation), "buy" (auto-BUY), "sell" (auto-SELL), "alternate" (BUY/SELL alternating)
# Example: TEST_MODE=buy generates a BUY signal every TEST_SIGNAL_INTERVAL cycles
TEST_MODE=off
TEST_SIGNAL_INTERVAL=3  # Generate test signal every N cycles (3 cycles * 60s = 180 seconds)

# Monitoring
ENABLE_API=true
API_HOST=0.0.0.0
API_PORT=8000
HEALTH_CHECK_INTERVAL=300
